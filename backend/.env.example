# Скопируй в .env. Значения ниже — только для локальной разработки.
DATABASE_URL=postgresql+asyncpg://konok:konok@localhost:5432/konok
TEST_DATABASE_URL=postgresql+asyncpg://konok:konok@localhost:5433/konok_test
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
# Папка загруженных файлов (по умолчанию ./storage)
STORAGE_DIR=storage
