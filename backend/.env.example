# Скопируйте в .env и заполните: cp .env.example .env

# --- Docker Compose ---------------------------------------------------------
# Пароль PostgreSQL (обязательно). DATABASE_URL и REDIS_URL compose задаёт сам.
POSTGRES_PASSWORD=change-me
# Порт API на сервере: 80 — сайт доступен по http://<IP сервера>/
API_PORT=8000

# --- Запуск без Docker (uv run ...) -----------------------------------------
# PostgreSQL (драйвер asyncpg) и Redis (OTP-коды, refresh-токены, rate limit, очередь задач).
DATABASE_URL=postgresql+asyncpg://konok:konok@localhost:5432/konok
REDIS_URL=redis://localhost:6379/0

# --- Приложение -------------------------------------------------------------

# Секрет для JWT и сессии админки: длинная случайная строка.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Домены фронтенда через запятую (CORS). Пусто — браузер не пустит запросы с других доменов.
CORS_ORIGINS=http://localhost:3000

# Срок жизни токенов и кода из письма.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
OTP_MINUTES=10

# Платёжный провайдер. Сейчас только mock (без реальных денег):
# платёж оплачивается вызовом POST /api/v1/payments/{id}/mock-pay.
PAYMENT_PROVIDER=mock

# Почта для кодов подтверждения. Пустой SMTP_HOST — код пишется в лог сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@konok.kg

# Azure AI Translator — перевод сообщений чата. Пустой ключ — сообщения без перевода.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Web push (VAPID). Сгенерировать пару: python scripts/generate_vapid_keys.py
# Пустой VAPID_PRIVATE_KEY — уведомления сохраняются, но push не отправляется.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@konok.kg

# Папка загруженных файлов: public/ — фото (/media/...), private/ — документы KYC.
STORAGE_DIR=storage

# Только для тестов (pytest): отдельная база (docker compose --profile test up -d).
TEST_DATABASE_URL=postgresql+asyncpg://konok:konok@localhost:5433/konok_test
