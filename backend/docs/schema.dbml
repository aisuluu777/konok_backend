// «Конок» — схема БД MVP, версия 0.4 (DBML для dbdiagram.io)
// Источник истины — schema.sql. Здесь только таблицы, поля и связи:
// CHECK-ограничения, запреты пересечений броней (EXCLUDE) и частичные индексы
// в DBML не выражаются — они описаны в note и в SQL-файле.

Project konok {
  database_type: 'PostgreSQL'
}

// ---------------------------------------------------------------------
// Типы
// ---------------------------------------------------------------------
Enum user_role {
  user [note: 'хозяин и владелец машины — не роли, а данные']
  moderator
  admin
}

Enum user_status {
  active
  blocked
}

Enum kyc_status {
  not_started
  pending
  approved
  rejected
  resubmission
}

Enum resident_type {
  kg_resident
  foreigner
}

Enum booking_type {
  stay [note: 'проживание у хозяина']
  vehicle [note: 'аренда машины']
}

Enum booking_status {
  hold [note: 'места удержаны, ждём оплату']
  confirmed [note: 'оплачено, подтверждено автоматически']
  in_progress [note: 'PIN введён, гость заселён']
  completed
  cancelled_by_guest
  cancelled_by_support
  expired [note: 'удержание истекло без оплаты']
  no_show [note: 'гость не приехал, хозяин получает оплату']
}

Enum payment_status {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

Enum refund_status {
  pending
  succeeded
  failed
}

Enum payout_status {
  pending
  paid
  failed
}

Enum review_status {
  published
  hidden
}

Enum ticket_status {
  new
  in_progress
  waiting_reply
  resolved
  closed
}

// ---------------------------------------------------------------------
// Справочники и настройки
// ---------------------------------------------------------------------
Table regions {
  id smallint [pk, increment]
  name text [not null, unique]
}

Table tags {
  id smallint [pk, increment]
  name text [not null, unique]
  Note: 'Теги занятий. Список ведёт администратор, хозяин только выбирает.'
}

Table settings {
  key text [pk]
  value text [not null]
  updated_by bigint [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'hold_minutes, host_ack_reminder_hours, checkin_time, checkout_time, commission_rate'
}

// ---------------------------------------------------------------------
// Пользователи и KYC
// ---------------------------------------------------------------------
Table users {
  id bigint [pk, increment]
  role user_role [not null, default: 'user']
  status user_status [not null, default: 'active']
  first_name text [not null]
  last_name text [not null]
  email text [not null, unique, note: 'уникален без учёта регистра']
  phone text [not null, unique]
  password_hash text [not null]
  phone_verified_at timestamptz
  terms_accepted_at timestamptz [not null]
  kyc_status kyc_status [not null, default: 'not_started', note: 'копия статуса последней проверки']
  checkin_pin text [note: 'PIN заселения (R-23), 6 цифр, выдаётся при одобрении KYC; хранится открыто — решение MVP, не окончательное']
  languages "text[]" [not null, default: '{}', note: 'коды языков: ky, ru, en']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'SMS-коды подтверждения телефона хранятся в Redis, не в БД.'
}

Table kyc_verifications {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  resident_type resident_type [note: 'у хозяина обязателен']
  provider text [not null, default: 'manual', note: 'manual | tunduk | внешний провайдер']
  provider_reference text
  status kyc_status [not null, default: 'pending']
  passport_file_url text
  selfie_file_url text
  rejection_reason text
  reviewed_by bigint [ref: > users.id]
  submitted_at timestamptz [not null, default: `now()`]
  checked_at timestamptz
}

// ---------------------------------------------------------------------
// Профили и занятия
// ---------------------------------------------------------------------
Table guest_profiles {
  user_id bigint [pk, ref: - users.id]
  country text
  birth_date date [note: 'хозяин видит только возраст']
  avatar_url text
  interests "text[]" [not null, default: '{}']
  updated_at timestamptz [not null, default: `now()`]
}

Table host_profiles {
  user_id bigint [pk, ref: - users.id]
  region_id smallint [not null, ref: > regions.id]
  settlement text [not null, note: 'населённый пункт, виден публично']
  address text [not null, note: 'точный адрес: гостю только после оплаты']
  latitude "numeric(9,6)"
  longitude "numeric(9,6)"
  about text
  avatar_url text
  photos "text[]" [not null, default: '{}', note: 'порядок в массиве = порядок показа']
  video_url text [note: 'MP4 до 2 минут']
  video_duration_sec smallint
  capacity smallint [not null, note: 'максимум гостей на ночь']
  price_per_person_night "numeric(12,2)" [not null, note: 'сом, питание включено']
  blocked_dates "date[]" [not null, default: '{}', note: 'дни, закрытые хозяином']
  is_guide boolean [not null, default: false]
  is_published boolean [not null, default: false]
  rating_avg "numeric(3,2)" [not null, default: 0]
  reviews_count integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table activities {
  id bigint [pk, increment]
  host_id bigint [not null, ref: > host_profiles.user_id]
  name text [not null]
  description text
  price_per_person "numeric(12,2)" [not null, note: '> 0']
  is_active boolean [not null, default: true, note: 'купленное занятие скрывается, а не удаляется']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Занятия создаёт хозяин. Количество не ограничено.'
}

Table activity_tags {
  activity_id bigint [not null, ref: > activities.id]
  tag_id smallint [not null, ref: > tags.id]
  Indexes {
    (activity_id, tag_id) [pk]
  }
}

// ---------------------------------------------------------------------
// Места
// ---------------------------------------------------------------------
Table places {
  id bigint [pk, increment]
  slug text [not null, unique]
  name text [not null]
  region_id smallint [not null, ref: > regions.id]
  short_description text
  description text
  cover_url text
  stops jsonb [not null, default: '[]', note: 'Места для остановки']
  travel_options jsonb [not null, default: '[]', note: 'Способы путешествия']
  created_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// Транспорт
// ---------------------------------------------------------------------
Table vehicles {
  id bigint [pk, increment]
  owner_id bigint [not null, ref: > users.id, note: 'любой user']
  region_id smallint [not null, ref: > regions.id]
  model text [not null]
  year smallint
  seats smallint
  transmission text
  fuel text
  specs jsonb [not null, default: '{}']
  included jsonb [not null, default: '[]', note: 'Что включено']
  photos "text[]" [not null, default: '{}']
  price_per_day "numeric(12,2)" [not null, note: 'сом']
  with_driver boolean [not null, default: false]
  is_published boolean [not null, default: false]
  rating_avg "numeric(3,2)" [not null, default: 0]
  reviews_count integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// Бронирование
// ---------------------------------------------------------------------
Table bookings {
  id bigint [pk, increment]
  type booking_type [not null]
  guest_id bigint [not null, ref: > users.id]
  host_id bigint [ref: > host_profiles.user_id, note: 'только stay']
  vehicle_id bigint [ref: > vehicles.id, note: 'только vehicle']
  start_date date [not null, note: 'stay: заезд; vehicle: начало аренды']
  end_date date [not null, note: 'stay: выезд; vehicle: конец аренды']
  unit_price "numeric(12,2)" [not null, note: 'stay: за человека за ночь; vehicle: за день']
  base_amount "numeric(12,2)" [not null, note: 'проживание или аренда, без занятий']
  commission_rate "numeric(5,4)" [not null, note: 'снимок ставки для всех платежей брони']
  currency "char(3)" [not null, default: 'KGS']
  status booking_status [not null, default: 'hold']
  hold_expires_at timestamptz [not null]
  confirmed_at timestamptz
  completed_at timestamptz
  cancelled_at timestamptz
  cancelled_by bigint [ref: > users.id]
  cancel_reason text
  guests_count smallint [note: 'только stay']
  arrival_time time [note: 'только stay, не раньше 13:00']
  host_acknowledged_at timestamptz [note: 'только stay: «Вижу, жду гостя»']
  checkin_pin_attempts smallint [not null, default: 0]
  checked_in_at timestamptz [note: 'только stay: PIN введён']
  pickup_location text [note: 'только vehicle']
  return_location text [note: 'только vehicle']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: '''
  Заполнены только поля своего типа (CHECK). guest_id <> host_id.
  base_amount = unit_price × гости (для машины 1) × (end_date − start_date).
  EXCLUDE: у туриста нет пересекающихся активных броней stay;
  одна машина не бронируется дважды на пересекающиеся дни.
  '''
}

Table booking_activities {
  id bigint [pk, increment]
  booking_id bigint [not null, ref: > bookings.id]
  activity_id bigint [not null, ref: > activities.id]
  activity_name text [not null, note: 'снимок названия']
  persons smallint [not null]
  price_per_person "numeric(12,2)" [not null, note: 'снимок цены']
  amount "numeric(12,2)" [not null, note: 'price_per_person × persons']
  payment_id bigint [not null, ref: > payments.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Купленные занятия брони stay. Отдельно не отменяются.'
}

// ---------------------------------------------------------------------
// Деньги
// ---------------------------------------------------------------------
Table payments {
  id bigint [pk, increment]
  booking_id bigint [not null, ref: > bookings.id]
  payer_id bigint [not null, ref: > users.id]
  provider text [not null, default: 'mock', note: 'mock | mbank']
  provider_transaction_id text
  idempotency_key text [not null, unique]
  amount "numeric(12,2)" [not null]
  commission_amount "numeric(12,2)" [not null, note: 'amount × bookings.commission_rate']
  currency "char(3)" [not null, default: 'KGS']
  status payment_status [not null, default: 'pending']
  payout_id bigint [ref: > payouts.id, note: 'пусто = ещё не выплачен']
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table payouts {
  id bigint [pk, increment]
  booking_id bigint [not null, ref: > bookings.id]
  recipient_id bigint [not null, ref: > users.id, note: 'хозяин или владелец машины']
  amount "numeric(12,2)" [not null, note: 'Σ (amount − commission_amount) платежей']
  currency "char(3)" [not null, default: 'KGS']
  status payout_status [not null, default: 'pending']
  provider_reference text
  created_at timestamptz [not null, default: `now()`]
  paid_at timestamptz
}

Table refunds {
  id bigint [pk, increment]
  payment_id bigint [not null, ref: > payments.id]
  amount "numeric(12,2)" [not null]
  reason text
  status refund_status [not null, default: 'pending']
  initiated_by bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
}

// ---------------------------------------------------------------------
// Чат
// ---------------------------------------------------------------------
Table conversations {
  id bigint [pk, increment]
  guest_id bigint [not null, ref: > users.id]
  provider_id bigint [not null, ref: > users.id, note: 'хозяин или владелец машины']
  last_message_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (guest_id, provider_id) [unique]
  }
}

Table messages {
  id bigint [pk, increment]
  conversation_id bigint [not null, ref: > conversations.id]
  sender_id bigint [not null, ref: > users.id]
  original_text text [not null]
  original_language "varchar(8)"
  translated_text text
  translated_language "varchar(8)"
  is_flagged boolean [not null, default: false, note: 'подозрение на обход платформы']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// Отзывы и избранное
// ---------------------------------------------------------------------
Table reviews {
  id bigint [pk, increment]
  booking_id bigint [not null, ref: > bookings.id]
  author_id bigint [not null, ref: > users.id]
  target_user_id bigint [not null, ref: > users.id, note: 'хозяин или владелец машины']
  rating smallint [not null, note: '1–5']
  text text
  status review_status [not null, default: 'published']
  created_at timestamptz [not null, default: `now()`]
  Indexes {
    (booking_id, author_id) [unique]
  }
}

Table favorites {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  host_id bigint [ref: > host_profiles.user_id]
  place_id bigint [ref: > places.id]
  vehicle_id bigint [ref: > vehicles.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Заполнено ровно одно из: host_id, place_id, vehicle_id.'
}

// ---------------------------------------------------------------------
// Поддержка, журнал, уведомления
// ---------------------------------------------------------------------
Table support_tickets {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, note: 'пусто для автотикета']
  booking_id bigint [ref: > bookings.id]
  category text [not null, note: 'host_unreachable, emergency, booking_problem, complaint …']
  description text
  status ticket_status [not null, default: 'new']
  assigned_to bigint [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table audit_logs {
  id bigint [pk, increment]
  actor_id bigint [ref: > users.id, note: 'пусто = действие системы']
  action text [not null]
  entity_type text [not null]
  entity_id bigint
  details jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  type text [not null]
  channel text [not null, default: 'in_app', note: 'in_app | email | sms']
  payload jsonb [not null, default: '{}']
  sent_at timestamptz
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}
